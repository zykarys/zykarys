#!/usr/bin/env bash
# zyk version guard: pre-push hook (hook version 1.0.0).
# Policy: zykarys-lab domains/operations/VERSIONING.md. Scope: zyk repos only
# (univiron/zykarys.com, zykarys/zykarys-lab, zykarys/zykarys).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Pushes that update refs/heads/main are BLOCKED unless:
#   1. VERSION (in the pushed commit) is valid X.Y.Z and strictly higher than remote main's VERSION
#   2. each step is exactly one tick: patch+1, or minor+1 with patch 0 (no skipped numbers)
#   3. MAJOR is unchanged, unless .major-approved names the exact new version and kV's approval
#      (agents NEVER create .major-approved; only kV's ceremony does)
#   4. CHANGELOG.md has "## [X.Y.Z] - YYYY-MM-DD"
#   5. package.json "version" (if present) equals VERSION
#   6. an annotated tag vX.Y.Z points at the pushed commit
# Other branches: warn (never block) when [Unreleased] gains no "(minor)"/"(patch)" line.
# Never bypass with --no-verify (lab rule: needs kV's confirmation).
set -u
remote_name="${1:-origin}"
Z=0000000000000000000000000000000000000000
RE='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
fail=0
say()  { printf 'version-guard: %s\n' "$*" >&2; }
err()  { printf 'version-guard: BLOCKED: %s\n' "$*" >&2; fail=1; }
blob() { git cat-file -e "$1:$2" 2>/dev/null && git show "$1:$2" 2>/dev/null; }
ver_at() { blob "$1" VERSION | head -n1 | tr -d ' \t\r'; }
pkg_ver() { blob "$1" package.json | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/'; }
unrel() { blob "$1" CHANGELOG.md | awk '/^## \[Unreleased\]/{f=1;next} /^## \[/{f=0} f' | grep -E '^[-*] *\((minor|patch)\)' ; }
# one_step OLD NEW -> 0 ok, 1 not one step, 2 major change
one_step() {
  [[ $1 =~ $RE ]] || return 1; local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]} c=${BASH_REMATCH[3]}
  [[ $2 =~ $RE ]] || return 1; local x=${BASH_REMATCH[1]} y=${BASH_REMATCH[2]} w=${BASH_REMATCH[3]}
  [ "$x" != "$a" ] && return 2
  { [ "$y" = "$b" ] && [ "$w" = $((c+1)) ]; } && return 0
  { [ "$y" = $((b+1)) ] && [ "$w" = 0 ]; } && return 0
  return 1
}
major_ok() { # NEW: .major-approved (working tree or commit) names NEW and references kV
  local f; f=$( { cat "$(git rev-parse --show-toplevel)/.major-approved" 2>/dev/null; blob "$2" .major-approved; } )
  printf '%s\n' "$f" | grep -E "^v?$(printf '%s' "$1" | sed 's/\./\\./g')([^0-9.]|$)" | grep -q 'kV'
}

while read -r lref lsha rref rsha; do
  [ -z "${lref:-}" ] && continue
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  if [ "$lsha" = "$Z" ]; then
    [ "$rref" = refs/heads/main ] && err "deleting main is never allowed"
    continue
  fi
  new=$(ver_at "$lsha")
  old=""; have_old=0
  if [ "$rsha" != "$Z" ]; then
    if git cat-file -e "$rsha^{commit}" 2>/dev/null; then have_old=1; old=$(ver_at "$rsha")
    else
      [ "$rref" = refs/heads/main ] && err "remote $rref ($rsha) is not in this clone; run 'git fetch $remote_name' first"
      continue
    fi
  fi

  if [ "$rref" != refs/heads/main ]; then
    base=$rsha; [ "$have_old" = 1 ] || { base=$(git rev-parse -q --verify "refs/remotes/$remote_name/main" || echo ""); [ -n "$base" ] && old=$(ver_at "$base"); }
    if [ "$new" = "$old" ] || [ -z "$new" ]; then
      added=$(comm -13 <( [ -n "$base" ] && unrel "$base" | sort -u ) <(unrel "$lsha" | sort -u))
      [ -z "$added" ] && say "WARNING ($rref): no new '- (minor) …' or '- (patch) …' line under [Unreleased] in CHANGELOG.md. Add one before this reaches main."
    fi
    continue
  fi

  # ---- main ----
  fail_before=$fail; fail=0
  if ! [[ $new =~ $RE ]]; then err "VERSION in the pushed commit is missing or not X.Y.Z (got '${new}')"; continue; fi
  if [ -z "$old" ]; then
    say "remote main has no VERSION (first push or first versioned release); accepting $new as the starting version"
  elif [ "$new" = "$old" ]; then
    err "VERSION is still $old: every push to main must tick it (patch or minor). Bump VERSION, add a CHANGELOG entry, tag."
  else
    # walk first-parent history remote..local, checking each VERSION change is one step
    prev=$old; seq=""
    for c in $(git rev-list --first-parent --reverse "$rsha..$lsha"); do
      v=$(ver_at "$c"); [ -z "$v" ] || [ "$v" = "$prev" ] && continue
      seq="$seq $v"
      one_step "$prev" "$v"; r=$?
      if [ $r = 2 ]; then
        if major_ok "$v" "$lsha"; then say "major $prev -> $v accepted: .major-approved names it (kV ceremony)"
        else err "major bump needs kV ceremony ($prev -> $v). Only kV's explicit 'yes, major' in chat, recorded in .major-approved, unlocks this; agents never create that file."
        fi
      elif [ $r = 1 ]; then
        err "$prev -> $v is not a single step (allowed: patch+1, or minor+1 with patch 0; no skipped numbers)"
      fi
      prev=$v
    done
    [ "$prev" = "$new" ] || err "VERSION history from $old does not end at $new (got: ${seq:- none})"
  fi
  blob "$lsha" CHANGELOG.md | grep -Eq "^## \[$(printf '%s' "$new" | sed 's/\./\\./g')\] - [0-9]{4}-[0-9]{2}-[0-9]{2}( |$)" \
    || err "CHANGELOG.md has no '## [$new] - YYYY-MM-DD' entry"
  if git cat-file -e "$lsha:package.json" 2>/dev/null; then
    pv=$(pkg_ver "$lsha"); [ "$pv" = "$new" ] || err "package.json version is '$pv', VERSION is $new"
  fi
  tag="v$new"
  if [ "$(git cat-file -t "refs/tags/$tag" 2>/dev/null)" != tag ] || [ "$(git rev-parse -q --verify "refs/tags/$tag^{commit}")" != "$lsha" ]; then
    err "no annotated tag $tag on the pushed commit $(git rev-parse --short "$lsha"). Run:
    git tag -a $tag -m \"$tag — <one-line summary>\" $(git rev-parse --short "$lsha")
  then push again with the tag: git push $remote_name main $tag"
  elif [ $fail = 0 ]; then
    say "main -> $new ok ($tag on $(git rev-parse --short "$lsha")). Push the tag too: git push $remote_name $tag (or use --follow-tags)"
  fi
  [ $fail = 0 ] && fail=$fail_before
done
[ $fail = 0 ] || { say "push refused. Policy: VERSIONING.md (zykarys-lab). Do not use --no-verify."; exit 1; }
exit 0
